# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit credentials.


# Email Configuration for Test Report Delivery

# Email service provider (gmail, outlook, custom SMTP, etc.)
EMAIL_SERVICE=gmail

# Your email address (sender)
EMAIL_USER=your-sender@example.com

# Email password. Prefer an app password / OAuth2 token over your
# real account password — required anyway once MFA is enforced.
EMAIL_PASSWORD=your-app-password

# Recipient email address.
# dotenv keeps the FIRST assignment and discards later duplicates,
# so keep this on ONE line. Multiple recipients = comma-separated.
EMAIL_TO=recipient@example.com

# Test Environment Base URL (optional — npm run test:dev|staging|prod overrides it)
BASE_URL=https://demo.pracsys.simplertoday.ai/login

# Admin console sign-in page and account, used by Master_Admin/Master_Login_Page.spec.ts
ADMIN_URL=https://your-admin-console.example.com/login
TEST_EMAIL_MASTER_ADMIN=admin-email@example.com
TEST_PASSWORD_MASTER_ADMIN=admin-password
# Optional: the account's authenticator (TOTP) secret — the base32 key shown when
# MFA was set up. Enables the full sign-in test; without it that test is skipped.
TEST_TOTP_SECRET_MASTER_ADMIN=
# Fallback when the secret isn't available: single-use recovery codes, comma-separated.
# Each run uses one; used codes are recorded in .auth/ and the last 2 are never used.
TEST_MFA_RECOVERY_CODES_MASTER_ADMIN=

# Login credentials used by Login.spec.ts
TEST_EMAIL=your-login-email@example.com
TEST_PASSWORD=your-login-password

# Absolute path to the file used by the Document Draft upload test
TEST_FILE_PATH=C:\path\to\Conversation.pdf

# Role-based login credentials used by RoleBase.spec.ts
TEST_EMAIL_PLATFORM_ADMIN=platform-admin@example.com
TEST_PASSWORD_PLATFORM_ADMIN=your-password

TEST_EMAIL_FIRM_ADMIN=firm-admin@example.com
TEST_PASSWORD_FIRM_ADMIN=your-password

# ── MFA sign-in tests (SimplerToday/security/MfaSignIn.spec.ts) ──────────────
# Optional. Without these the MFA tests skip themselves instead of failing, so
# the suite stays green on environments where MFA is not yet enabled.

# An MFA-enrolled platform admin.
TEST_EMAIL_MFA=
TEST_PASSWORD_MFA=

# The base32 secret from that account's MFA enrolment — the same string the
# enrolment QR code encodes. Used to generate valid 6-digit codes locally.
TEST_TOTP_SECRET_MFA=

# One unused recovery code for that account. SINGLE USE — a run consumes it,
# so replace it before the next run. Leave blank to skip the recovery-code test.
TEST_MFA_RECOVERY_CODE=

# ── Forced password change (SimplerToday/security/ForcedPasswordChange.spec.ts)
# Optional. An account an admin has flagged to change its password at next
# sign-in. The flag clears once the password is actually changed, so it has to
# be re-set before each run.
TEST_EMAIL_FORCE_PWD=
TEST_PASSWORD_FORCE_PWD=
