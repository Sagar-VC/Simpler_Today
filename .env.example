# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit credentials.

TEST_EMAIL=your-login-email@example.com
TEST_PASSWORD= your-login-password

# Role-based login credentials used by RoleBase.spec.ts
TEST_EMAIL_PLATFORM_ADMIN=platform-admin@example.com
TEST_PASSWORD_PLATFORM_ADMIN=your-password

TEST_EMAIL_FIRM_ADMIN=firm-admin@example.com
TEST_PASSWORD_FIRM_ADMIN=your-password
